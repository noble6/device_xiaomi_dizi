<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Your forks -->
  <remote name="noble" fetch="https://github.com/noble6" />
  <!-- g8row: upstream dizi trees -->
  <remote name="dizi" fetch="https://github.com/g8row" />
  <!-- Not defined by Axion manifest, dizi needs them -->
  <remote name="evo-devices" fetch="https://github.com/Evolution-X-Devices" />
  <remote name="github-non-los" fetch="https://github.com" />

  <!-- ruan layer (yours) -->
  <project path="device/xiaomi/ruan" name="device_xiaomi_ruan_new" remote="noble" revision="bka" />
  <project path="vendor/xiaomi/ruan" name="vendor_xiaomi_ruan_new" remote="noble" revision="bka" />

  <!-- Kernel artefacts: prebuilt GKI Image, dtb, dtbo, modules (yours) -->
  <project path="device/xiaomi/dizi-kernel" name="device_xiaomi_dizi-kernel" remote="noble" revision="bka" />

  <!-- Shared dizi base tree + dizi blobs -->
  <project path="device/xiaomi/dizi" name="device_xiaomi_dizi" remote="dizi" revision="lineage-23.2" />
  <project path="vendor/xiaomi/dizi" name="vendor_xiaomi_dizi" remote="dizi" revision="lineage-23.2" />

  <!-- UAPI headers for the QTI HALs + shared deps -->
  <project path="kernel/xiaomi/sm7435" name="kernel_xiaomi_garnet" remote="evo-devices" revision="bka" clone-depth="1" />
  <project path="kernel/xiaomi/sm7435-modules" name="kernel_xiaomi_garnet-modules" remote="evo-devices" revision="bka" clone-depth="1" />
  <project path="hardware/xiaomi" name="Evolution-X-Devices/hardware_xiaomi" remote="github-non-los" revision="bka-no-dolby" />
  <project path="hardware/dolby" name="Evolution-X-Devices/hardware_dolby" remote="github-non-los" revision="bka-aospa" />
  <project path="packages/apps/GameBar" name="packages_apps_GameBar" remote="evo-devices" revision="bka" />
</manifest>
